#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python="$here/.venv/bin/python"

if [ ! -x "$python" ]; then
  echo "subs2dub is not set up yet. Run:"
  echo "  $here/scripts/setup.sh"
  exit 1
fi

if [ $# -gt 0 ]; then
  case "$1" in
    build|wizard|-h|--help) ;;
    *) set -- build "$@" ;;
  esac
fi

exec "$python" -m subs2dub "$@"

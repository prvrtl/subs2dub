# Environments
.venv/
.venv-vision/
__pycache__/
*.py[cod]
*.egg-info/

# Model weights, fetched by scripts/setup.sh
checkpoints_ov/
vendor/

# Third-party source fetched at setup time
OpenVoice/

# Working directories: stems, caches, references, synthesized audio.
# Everything here is derived from copyrighted source material.
work/
work_*/
*.srt
*.ass
*.vtt
*.lab

# Weights downloaded at runtime. Redistributing them here would both bloat the
# repository and re-license someone else's model.
models/
checkpoints/

# Media. Never commit source films, clips, previews or rendered dubs.
*.mkv
*.mp4
*.avi
*.mov
*.webm
*.wav
*.flac
*.mp3
*.m4a
*.aac
*.ogg

# Reports contain dialogue text from the source subtitles
cast.tsv
overruns.tsv
*.log

# macOS
.DS_Store
